# =============================================================================
# MEA-KG Project — Environment Variable Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file to a new file named ".env" in the same directory.
#   2. Replace all placeholder values (your_*) with your actual credentials.
#   3. NEVER commit the ".env" file to version control (it is in .gitignore).
# =============================================================================

# --- Neo4j Graph Database ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# --- OpenAI-Compatible LLM API ---
# For OpenAI: https://api.openai.com/v1
# For compatible proxies (e.g., gptsapi): https://api.gptsapi.net/v1
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local LLM via Ollama (optional) ---
# Used by pipeline/mea_kg_builder when running local inference
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL_NAME=mea-kg-model

# --- Pipeline Parameters (optional overrides) ---
MAX_WORKERS=1
CHUNK_SIZE=2048
